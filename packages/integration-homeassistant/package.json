{
  "name": "@herzen/integration-homeassistant",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
