{
	"name": "@herzen/stt",
	"version": "0.0.1",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"herzen-stt": "dist/cli.js"
	},
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
