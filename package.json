{
	"name": "herzen",
	"private": true,
	"packageManager": "pnpm@9.0.0",
	"scripts": {
		"build": "pnpm -r build",
		"build:core": "pnpm --filter @herzen/core... build",
		"build:audio": "pnpm --filter @herzen/audio build",
		"dev": "pnpm -C packages/core dev:watch",
		"start": "pnpm build:core && pnpm --filter @herzen/core start",
		"lint": "pnpm -r lint",
		"typecheck": "pnpm -r typecheck",
		"clean": "pnpm -r clean"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.2.2",
		"eslint": "^10.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0"
	}
}
